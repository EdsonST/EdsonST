    <script>
        const STORAGE_KEY = 'plano-estudo-csharp-ia-v3';
        const STREAK_KEY = 'plano-estudo-streak';

        function loadState() {
            const saved = localStorage.getItem(STORAGE_KEY);
            return saved ? JSON.parse(saved) : {};
        }

        function saveState(state) {
            localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
        }

        function loadStreak() {
            const saved = localStorage.getItem(STREAK_KEY);
            return saved ? JSON.parse(saved) : { count: 0, lastDate: null };
        }

        function saveStreak(streak) {
            localStorage.setItem(STREAK_KEY, JSON.stringify(streak));
        }

        function getToday() {
            return new Date().toISOString().split('T')[0];
        }

        function markToday() {
            const streak = loadStreak();
            const today = getToday();

            if (streak.lastDate === today) return;

            const yesterday = new Date();
            yesterday.setDate(yesterday.getDate() - 1);
            const yesterdayStr = yesterday.toISOString().split('T')[0];

            if (streak.lastDate === yesterdayStr) {
                streak.count += 1;
            } else if (streak.lastDate !== today) {
                streak.count = 1;
            }

            streak.lastDate = today;
            saveStreak(streak);
            updateStreakUI();
        }

        function updateStreakUI() {
            const streak = loadStreak();
            const today = getToday();
            const yesterday = new Date();
            yesterday.setDate(yesterday.getDate() - 1);
            const yesterdayStr = yesterday.toISOString().split('T')[0];

            if (streak.lastDate && streak.lastDate !== today && streak.lastDate !== yesterdayStr) {
                streak.count = 0;
                saveStreak(streak);
            }

            document.getElementById('streak-days').textContent = streak.count;

            const btn = document.getElementById('streak-btn');
            if (streak.lastDate === today) {
                btn.disabled = true;
                btn.textContent = 'Já marcou hoje ✓';
            } else {
                btn.disabled = false;
                btn.textContent = 'Estudei hoje ✓';
            }
        }

        function togglePhase(header) {
            const phase = header.closest('.phase');
            phase.classList.toggle('open');
        }

        function updateProgress() {
            const checkboxes = document.querySelectorAll('input[data-task]');
            const total = checkboxes.length;
            const completed = document.querySelectorAll('input[data-task]:checked').length;
            const percent = total > 0 ? Math.round((completed / total) * 100) : 0;

            document.getElementById('completed-count').textContent = completed;
            document.getElementById('total-count').textContent = total;
            document.getElementById('percent-count').textContent = percent + '%';
            document.getElementById('main-progress').style.width = percent + '%';
            document.getElementById('progress-label').textContent = percent + '% completo';

            // Fases 0 a 7 + fase 8 (bônus)
            ['0','1','2','3','4','5','6','7','8'].forEach(i => {
                const phaseCompleted = document.querySelectorAll(`.phase[data-phase="${i}"] input[data-task]:checked`).length;
                const phaseTotal = document.querySelectorAll(`.phase[data-phase="${i}"] input[data-task]`).length;
                const progressEl = document.querySelector(`[data-phase-progress="${i}"]`);
                if (progressEl) {
                    progressEl.textContent = `${phaseCompleted}/${phaseTotal}`;
                }
            });
        }

        function init() {
            const state = loadState();
            const checkboxes = document.querySelectorAll('input[data-task]');

            checkboxes.forEach(cb => {
                const task = cb.getAttribute('data-task');
                if (state[task]) cb.checked = true;

                cb.addEventListener('change', () => {
                    const currentState = loadState();
                    currentState[task] = cb.checked;
                    saveState(currentState);
                    updateProgress();
                });
            });

            updateProgress();
            updateStreakUI();
        }

        function resetAll() {
            if (confirm('Tem certeza que quer resetar todo o progresso? Isso não pode ser desfeito.')) {
                localStorage.removeItem(STORAGE_KEY);
                localStorage.removeItem(STREAK_KEY);
                document.querySelectorAll('input[data-task]').forEach(cb => cb.checked = false);
                updateProgress();
                updateStreakUI();
            }
        }

        init();
    </script>
</body>
</html>
